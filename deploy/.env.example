# Local Compose environment only. Replace every secret before shared deployment.
PVE_ENVIRONMENT=development
PVE_HTTP_ADDRESS=:8080
PVE_LOG_LEVEL=info

POSTGRES_DB=pve_classroom
POSTGRES_USER=pve_classroom
POSTGRES_PASSWORD=replace-with-a-long-random-password
PVE_DATABASE_URL=postgres://pve_classroom:replace-with-a-long-random-password@postgres:5432/pve_classroom?sslmode=disable

PVE_STORE_DRIVER=postgres
PVE_ADAPTER=fake
PVE_EMBEDDED_WORKER=false
PVE_OPERATION_WAVE_SIZE=10
PVE_WORKER_POLL_INTERVAL=1s
PVE_WORKER_LEASE=2m
PVE_FAKE_DELAY=50ms
PVE_REQUEST_TIMEOUT=15s
PVE_TASK_TIMEOUT=30m
PVE_TASK_POLL_INTERVAL=1s
PVE_ALLOWED_ORIGINS=http://localhost:8088

# Real PVE settings are intentionally commented out in the Fake development stack.
# When enabling file-based secrets, mount the referenced files with a Compose override.
# PVE_ADAPTER=http
# PVE_CLUSTER_ID=70000000-0000-4000-8000-000000000001
# PVE_MANAGED_POOL=cloud-classroom-managed
# PVE_BASE_URL=https://pve.example.edu:8006
# PVE_TOKEN_ID=cloudclass@pve!controller
# PVE_TOKEN_SECRET_FILE=/run/secrets/pve-token
# PVE_CA_CERT_FILE=/run/secrets/school-internal-ca.pem
