# Runtime
PVE_ENVIRONMENT=development
PVE_LOG_LEVEL=info
PVE_HTTP_ADDRESS=:8080
PVE_ALLOWED_ORIGINS=http://localhost:5173

# Persistence: development may use memory; production must use postgres.
PVE_STORE_DRIVER=memory
# PVE_DATABASE_URL=postgres://pve_classroom:change-me@postgres:5432/pve_classroom?sslmode=require

# PVE integration. Fake is intentionally rejected in production.
PVE_ADAPTER=fake
PVE_FAKE_DELAY=25ms
PVE_REQUEST_TIMEOUT=15s
PVE_TASK_TIMEOUT=30m

# Task execution
PVE_EMBEDDED_WORKER=true
PVE_OPERATION_WAVE_SIZE=10
PVE_WORKER_POLL_INTERVAL=1s
PVE_WORKER_LEASE=2m

# HTTP lifecycle
PVE_SHUTDOWN_TIMEOUT=15s
PVE_HTTP_READ_HEADER_TIMEOUT=5s
PVE_HTTP_READ_TIMEOUT=15s
PVE_HTTP_WRITE_TIMEOUT=30s
PVE_HTTP_IDLE_TIMEOUT=60s
